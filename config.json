{
    "models_dir": "\\\\192.168.0.240\\project\\Ken_Lin\\models",

    "whisper_model": "faster-distil-whisper-medium.en",
    "translate_model": "nllb-200-distilled-1.3B",
    "translate_model_ct2": "nllb-200-distilled-1.3B-ct2",

    "model_required_files": {
        "faster-distil-whisper-medium.en": [
            "config.json",
            "model.bin",
            "preprocessor_config.json",
            "tokenizer.json",
            "vocabulary.json"
        ],
        "nllb-200-distilled-1.3B": [
            "config.json",
            "generation_config.json",
            "sentencepiece.bpe.model",
            "special_tokens_map.json",
            "tokenizer.json",
            "tokenizer_config.json"
        ],
        "nllb-200-distilled-1.3B-ct2": [
            "config.json",
            "model.bin",
            "shared_vocabulary.json"
        ]
    },

    "sample_rate": 16000,
    "window_seconds": 6,
    "step_seconds": 3,
    "beam_size": 3,
    "max_audio_queue": 4,
    "max_text_queue": 20,

    "whisper_cpu_threads_ratio": 0.2,
    "translator_intra_threads_ratio": 0.1,


    "silence_flush_threshold": 0.5,
    "min_buffer_len_for_punct_flush": 20,
    "min_buffer_len_for_silence_flush": 20,
    "max_buffer_len": 120
}